{
  "name": "cloud-storage-api",
  "version": "1.0.0",
  "description": "Production-grade ElysiaJS + Bun API for Multi-User Cloud Storage SaaS",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "drizzle-orm": "^0.39.3",
    "elysia": "^1.2.22",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
